# ---------- Database (Neon) ----------
# Neon dashboard -> Connect -> copy the *pooled* connection string
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# ---------- Admin login ----------
ADMIN_EMAIL="you@example.com"
# Generate with:  npm run hash-password -- "your-password"
# IMPORTANT: in .env files escape every $ as \$  (on Vercel paste the hash as-is)
ADMIN_PASSWORD_HASH=""
# Generate with:  openssl rand -base64 32
AUTH_SECRET=""

# ---------- Public site URL (used in share links) ----------
# Local: http://localhost:3000   Vercel: https://your-app.vercel.app (or your own domain)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------- Google Maps ----------
# Enable "Maps JavaScript API" + "Geocoding API". Restrict the key by HTTP referrer.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# ---------- Google Drive (OAuth, scope drive.file) ----------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REFRESH_TOKEN=""
